# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgres://nudge:nudge@localhost:5433/nudge
REDIS_URL=redis://localhost:6380
PORT=4000

# The public https URL Twilio can reach (use ngrok or a deployed URL). Twilio signs its webhooks
# with this exact URL, so it must match what you paste into Twilio's console.
PUBLIC_BASE_URL=https://your-bot.example.com

# From the Twilio console. A trial account can only text numbers you have verified there.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15005550006
# Leave the next line out to use the real Twilio. Point it at http://localhost:4020 to use scripts/fake-twilio.mjs.
# TWILIO_API_BASE=http://localhost:4020

# Shared with JAY-AESTHETIX (set the same value there as NUDGE_EVENTS_SECRET). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVENTS_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-to-a-different-long-random-string

# Behaviour (all optional)
DEFAULT_TIMEZONE=America/New_York
CHECKIN_HOUR=18          # daily check-in, in the client's local time
NAG_DELAY_MINUTES=90     # gap between nudges
MAX_NAGS=2
QUIET_HOURS_ENABLED=true # no nudges between QUIET_HOURS_START and QUIET_HOURS_END (local time)
QUIET_HOURS_START=21
QUIET_HOURS_END=8
